# Настройки D2K. Файл живёт в /etc/storage/d2k/config и правится через
# веб-интерфейс (Дополнительные настройки / D2K) либо редактором на роутере.
#
# /etc/storage — это tmpfs, который распаковывается из flash при загрузке.
# После правки файла редактором ОБЯЗАТЕЛЬНО перенесите его во flash:
#
#     /usr/bin/d2k.sh save
#
# Кнопка «Применить» на веб-странице делает это сама.
#
# Этот образец ставится в /usr/share/d2k/config.default и копируется в
# /etc/storage/d2k/config один раз — когда настроек там ещё нет. Свой файл
# прошивка больше не перезаписывает, в том числе при обновлении.
#
# Синтаксис: КЛЮЧ=значение, по одному в строке. Кавычки и комментарий в
# конце строки допустимы. Файл читают и оболочка (служба), и разборщики на C
# (панель, туннель), поэтому ни подстановок, ни команд здесь быть не должно.
# Незнакомый ключ панель не выполняет, а показывает как незнакомый.

SCHEMA=1

# Что служба делает с найденным обходом:
#   apply   — применять (рабочий режим);
#   observe — только искать и писать в журнал, трафик не менять;
#   off     — запуск движка запрещён (панель и правила остаются сняты).
MODE=apply

# Адрес встроенной панели D2K. У панели НЕТ пароля: пока здесь 127.0.0.1,
# она доступна только с самого роутера (ssh -L, см. описание интеграции).
# Открыть её в локальную сеть — 0.0.0.0:8090 — значит отдать управление
# обходом любому устройству в сети. Порт 8090 в прошивке больше никем не занят.
PANEL_LISTEN=127.0.0.1:8090

# Состояние: найденные планы (catalog.json), live.json для панели, статус
# туннеля. Каталог в tmpfs, поэтому после перезагрузки планы ищутся заново —
# это минуты работы, не часы. Переносить его в /etc/storage нельзя: раздел
# настроек всего 256 КБ, а каталог вырастает до сотни килобайт и
# перезаписывается постоянно.
STATE_DIR=/tmp/d2k/state

# Номер очереди NFQUEUE. Менять только при настоящем конфликте: 2000 в этой
# прошивке не занят (zapret использует 200).
QUEUE_NUM=2000

# Метка пакетов, по которой служба узнаёт свои собственные. 0x2d..0x30 заняты
# D2K (0x2d рабочая, 0x2e проба, 0x2f замер, 0x30 http). С метками
# WireGuard/AmneziaWG, Tor и zapret не пересекаются.
MARK=0x2d

###############################################################################
# Туннель Telegram (d2ktg)
#
# Это НЕ обход DPI, а отдельная служба: локальный порт 1443, куда правила
# заворачивают обращения к серверам Telegram, и дальше — WSS-соединение до
# внешнего ретранслятора. Трафик Telegram при этом идёт через чужой сервер.
# Поэтому по умолчанию выключено: включайте осознанно.
#
# Включать лучше командой, а не правкой файла — она ещё и правила поставит:
#     /usr/bin/d2k.sh telegram-enable && /usr/bin/d2k.sh save
###############################################################################
TG_ENABLED=0

# Ретранслятор по умолчанию — из поставки автора D2K (сторонний VPS).
TG_RELAY_URL=wss://213.176.74.63.nip.io/ws
TG_ENROLL_PORT=9443

# Ключ этого роутера (88 байт, Ed25519). Лежит в /etc/storage, чтобы ретранслятор
# после перезагрузки узнавал роутер, а не выдавал ему новую личность.
TG_IDENTITY=/etc/storage/d2k/tg.identity

TG_STATUS=/tmp/d2k/state/telegram.status
TG_CA_BUNDLE=/usr/share/d2k/files/tg-roots.pem

# Свой ретранслятор вместо регистрации по TG_ENROLL_PORT:
# TG_RELAY_SECRET=...

###############################################################################
# Остальные допустимые ключи — со значениями по умолчанию, которые служба
# подставляет сама. Раскомментируйте только то, что действительно меняете.
#
# PROBE_MARK=0x2e            метка проб
# FLOWS=2048                 сколько потоков движок держит в памяти
# STATS_SEC=900              период сводки в журнал, секунды
# HEAL_EVERY=                период сторожа правил, секунды
# PORTS=0:65535              порты, которые заворачиваются в очередь
# CONNBYTES=0:8              сколько первых пакетов потока смотреть
# VOICE_PORTS=50000:50099,1400,3478:3481,5349,19294:19344
# VOICE_CONNBYTES=0:4
# LOGMAX=2097152             размер журнала, после которого он урезается
# LOGKEEP=1048576            сколько от журнала остаётся после урезания
# LOG_EVERY=60               период проверки журналов, секунды
# D2K_RUNTIME_DIR=/tmp/d2k   рабочий каталог; задаётся обёрткой d2k.sh
# TG_PORT=1443               локальный порт туннеля; другое значение d2ktg
#                            не принимает
#
# Ключи CONTROL_SOCKET, DECOY_SNI и D2K_PPE_DEOFFLOAD панель считает
# законными, но в этой сборке они ни на что не влияют: путь к управляющему
# сокету служба берёт из своего рабочего каталога (/tmp/d2k/run/d2kd.sock),
# а разгрузка PPE — особенность Keenetic, здесь ускорителем управляет
# hw_nat_mode (его нужно выключить, иначе пакеты пройдут мимо очереди).
###############################################################################
