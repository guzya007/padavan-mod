+     * ничего не стоит и не зависит от того, появятся ли они.
+     *
+     * Неудача не смертельна. Без прав привязка не пройдёт, но тогда и очередь
+     * не привяжется — об этом честно скажет следующая команда. А если
+     * семейство уже привязал чужой клиент (nfqws), ядро ответит -EEXIST, и
+     * это подходящий исход: обработчик-то стоит. Кричать здесь значило бы
+     * пугать владельца рабочим состоянием, поэтому причина остаётся в why. */
+    {
+        static const uint16_t pf_bind_list[] = { AF_INET, AF_INET6 };
+        for (size_t i = 0; i < sizeof pf_bind_list / sizeof pf_bind_list[0]; i++) {
+            char why[160];
+            seq = q->seq++;
+            n = d2k_nl_cfg_cmd(msg, sizeof msg, cfg->queue, seq,
+                               D2K_NFQNL_CFG_CMD_PF_BIND, pf_bind_list[i]);
+            if (n == 0) {
+                say(err, errcap, "сообщение привязки семейства не собралось");
+                close(q->fd);
+                free(q);
+                return NULL;
+            }
+            if (send_and_ack(q, msg, n, seq, why, sizeof why) != 0) {
+                /* Пусто намеренно: см. последний абзац комментария выше.
+                   Причина отказа остаётся в why и дальше не идёт. */
+            }
+        }
+    }
 
     seq = q->seq++;
     n = d2k_nl_cfg_cmd(msg, sizeof msg, cfg->queue, seq,
--- a/datapath/include/d2k_nfq.h
+++ b/datapath/include/d2k_nfq.h
@@ -57,4 +57,23 @@
 /* Сколько раз ядро сообщало о потерянных сообщениях. */
 uint64_t d2k_nfq_lost(const d2k_nfq *q);
 
+/* Точка подмены обмена с очередью — для тестов.
+ *
+ * Право (CAP_NET_ADMIN) и версия ядра машины, где идёт тест, — не то, от чего
+ * должен зависеть вердикт теста. От них зависит именно настоящий обмен: без
+ * прав ядро отвечает отказом на привязку очереди, а на ядрах 3.8+ команда
+ * привязки семейства (PF_BIND) — пустышка, и «приняли» от неё ни о чём не
+ * говорит. А порядок и содержимое настроечных сообщений — это требование к
+ * ядру: от него зависит, будет ли датапат вообще видеть пакеты.
+ *
+ * Поэтому подменяется ОБМЕН целиком: тест читает БАЙТЫ запроса и отвечает за
+ * ядро. Сокет при этом создаёт, настраивает и закрывает тот же код, что и на
+ * роутере — подделывается переписка в коде теста, а не сокет ядра. Тот же
+ * приём и та же причина, что у d2k_nat_hook (datapath/include/d2k_nat.h).
+ *
+ * По умолчанию указывает на настоящий обмен. */
+typedef int (*d2k_nfq_xchg_fn)(d2k_nfq *q, const uint8_t *req, size_t req_len,
+                               uint32_t seq, char *err, size_t errcap);
+extern d2k_nfq_xchg_fn d2k_nfq_xchg_hook;
+
 #endif /* D2K_NFQ_H */
