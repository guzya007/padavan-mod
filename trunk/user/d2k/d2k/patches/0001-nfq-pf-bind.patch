# 0001: привязка семейств протоколов (PF_BIND) при открытии очереди NFQUEUE.
#
# ЗАЧЕМ. d2kd создаёт в ядре экземпляр очереди, но не привязывает его к
# семейству протоколов. В движке это было решено намеренно под ядра 3.8+, где
# PF_BIND — пустышка. В ядрах древнее 3.8 (прошивка padavan на NEWIFI-D2 —
# 3.4.113) без неё обработчик очереди для семейства не регистрируется вовсе:
# __nf_queue() отдаёт -ESRCH, а правила службы стоят с --queue-bypass и молча
# выпускают пакет дальше. Наружу это выглядит как «очередь привязана, служба
# работает» — и в очередь не приходит ни одного пакета: ни приветствий, ни
# подозрений, ни одной попытки подтвердить блокировку измерением, и подбор
# стратегий не начинается.
#
# Полевой случай: после каждой перезагрузки D2K не видел трафика, пока вручную
# не запустишь и не остановишь nfqws — он рассылает PF_BIND, а после его
# остановки привязка в ядре остаётся. Зависимости от nfqws после патча нет.
#
# ПАТЧ:
#   datapath/nfq.c              PF_BIND для AF_INET и AF_INET6 при открытии
#                               очереди; отказ ядра открытию не мешает;
#   datapath/include/d2k_nfq.h  точка подмены обмена для тестов (d2k_nat_hook);
#   datapath/test_nfq.c         регрессионный тест: читает БАЙТЫ настроечных
#                               сообщений, не завися от прав и версии ядра;
#   datapath/Makefile           цель test_nfq в check (только Linux: модуль
#                               очереди не собирается на mac).
#
# Проверено: make -C datapath check — зелёный, test_nfq без правки падает;
# make -C datapath d2kd собирается с -Werror; патч ложится на чистый архив
# 24578a1.
--- a/datapath/nfq.c
+++ b/datapath/nfq.c
@@ -107,8 +107,10 @@
     return -1;
 }
 
-static int send_and_ack(d2k_nfq *q, const uint8_t *msg, size_t len, uint32_t seq,
-                        char *err, size_t errcap) {
+/* Настоящий обмен с очередью: отправить настроечное сообщение и дождаться
+   подтверждения. Точка отсчёта для подмены (d2k_nfq_xchg_hook). */
+static int xchg_real(d2k_nfq *q, const uint8_t *msg, size_t len, uint32_t seq,
+                     char *err, size_t errcap) {
     if (len == 0) {
         say(err, errcap, "сообщение настройки не собралось");
         return -1;
@@ -120,6 +122,13 @@
     return await_ack(q->fd, seq, err, errcap);
 }
 
+d2k_nfq_xchg_fn d2k_nfq_xchg_hook = xchg_real;
+
+static int send_and_ack(d2k_nfq *q, const uint8_t *msg, size_t len, uint32_t seq,
+                        char *err, size_t errcap) {
+    return d2k_nfq_xchg_hook(q, msg, len, seq, err, errcap);
+}
+
 d2k_nfq *d2k_nfq_open(const d2k_nfq_cfg *cfg, char *err, size_t errcap) {
     if (!cfg) {
         say(err, errcap, "нет настроек очереди");
@@ -164,9 +173,51 @@
     uint32_t seq;
     size_t n;
 
-    /* PF_BIND намеренно не посылается: с ядра 3.8 команда — пустышка, а
-       целевое ядро 4.9. Замерщик этапа 0 обходился без неё на настоящем
-       устройстве. */
+    /* Привязка к семействам протоколов (PF_BIND).
+     *
+     * ОБЯЗАТЕЛЬНА на ядрах древнее 3.8: queue_handler[pf] там — глобальная
+     * таблица, и без этой команды для семейства записи не заводится. Тогда
+     * __nf_queue() отдаёт -ESRCH, а правила службы стоят с --queue-bypass и
+     * молча выпускают пакет дальше по цепочке. Снаружи это выглядит как
